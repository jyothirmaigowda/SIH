// SIMS Ã¢â‚¬â€ Prisma Schema
// Source of truth: /docs/SIMS-SPEC.md Ã¢â‚¬â€ Canonical Data Model section
// IMMUTABILITY RULE: DocumentVersion, EvidenceFile, CustodyEvent, ReportVersion, AuditLog
// rows are NEVER updated after insert. Corrections = new row.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  url = "file:./dev.db"
  provider = "sqlite"
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Enums Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬





































// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Police Command Hierarchy Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
// SEPARATE from administrative geography (spec requirement)

model PoliceOrganisation {
  id        String               @id @default(cuid())
  name      String
  level     String               // STATE | CITY_POLICE | DIVISION | SUB_DIVISION | STATION
  parentId  String?
  parent    PoliceOrganisation?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children  PoliceOrganisation[] @relation("OrgHierarchy")
  isDemo    Boolean              @default(true)
  users     User[]
  cases     Case[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Administrative Geography Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
// SEPARATE dimension Ã¢â‚¬â€ district/taluk/locality attaches to Case as location metadata only

model AdministrativeArea {
  id        String               @id @default(cuid())
  name      String
  level     String               // DISTRICT | TALUK | HOBLI | WARD | LOCALITY
  parentId  String?
  parent    AdministrativeArea?  @relation("AdminHierarchy", fields: [parentId], references: [id])
  children  AdministrativeArea[] @relation("AdminHierarchy")
  isDemo    Boolean              @default(true)
  locations Location[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Users Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model User {
  id                    String               @id @default(cuid())
  employeeId            String               @unique
  name                  String
  email                 String               @unique
  role                  String
  passwordHash          String
  mfaEnabled            Boolean              @default(false)
  mfaSecret             String?
  active                Boolean              @default(true)
  failedLoginAttempts   Int                  @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  stationId             String?
  station               PoliceOrganisation?  @relation(fields: [stationId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  caseAssignments       CaseAssignment[]
  uploadedDocuments     DocumentVersion[]
  collectedEvidence     Evidence[]
  custodyFrom           CustodyEvent[]       @relation("CustodyFrom")
  custodyTo             CustodyEvent[]       @relation("CustodyTo")
  custodyActor          CustodyEvent[]       @relation("CustodyActor")
  diaryEntries          InvestigationDiaryEntry[]
  supervisedEntries     InvestigationDiaryEntry[] @relation("DiaryEntrySupervisor")
  reportsCreated        Report[]
  reportVersions        ReportVersion[]
  reviews               Review[]
  certificates          Certificate[]
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@index([role])
  @@index([active])
  @@index([stationId])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Cases Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Case {
  id              String             @id @default(cuid())
  caseNumber      String             @unique
  firNumber       String?
  firDate         DateTime?
  title           String
  type            String
  offenceSections String
  status          String         @default("REGISTERED")
  priority        String       @default("NORMAL")
  stationId       String
  station         PoliceOrganisation @relation(fields: [stationId], references: [id])
  registeredAt    DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  assignments     CaseAssignment[]
  persons         Person[]
  locations       Location[]
  documents       Document[]
  evidence        Evidence[]
  diaryEntries    InvestigationDiaryEntry[]
  reports         Report[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  certificates    Certificate[]
  graphNodes      GraphNode[]
  graphEdges      GraphEdge[]

  @@index([status])
  @@index([stationId])
  @@index([firNumber])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Case Assignments Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model CaseAssignment {
  id           String             @id @default(cuid())
  caseId       String
  case         Case               @relation(fields: [caseId], references: [id])
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  role         String
  assignedById String
  assignedAt   DateTime           @default(now())
  removedAt    DateTime?
  active       Boolean            @default(true)

  @@unique([caseId, userId, role])
  @@index([caseId])
  @@index([userId])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Persons Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Person {
  id          String         @id @default(cuid())
  caseId      String
  case        Case           @relation(fields: [caseId], references: [id])
  category    String
  name        String
  identifiers String           @default("{}")
  contactInfo String           @default("{}")
  address     String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  graphNodes  GraphNode[]

  @@index([caseId])
  @@index([category])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Locations Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Location {
  id                   String              @id @default(cuid())
  caseId               String
  case                 Case                @relation(fields: [caseId], references: [id])
  label                String
  address              String?
  coordinates          String?
  administrativeAreaId String?
  administrativeArea   AdministrativeArea? @relation(fields: [administrativeAreaId], references: [id])
  createdAt            DateTime            @default(now())

  graphNodes           GraphNode[]

  @@index([caseId])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Documents (metadata only Ã¢â‚¬â€ bytes live in private storage) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Document {
  id          String         @id @default(cuid())
  caseId      String
  case        Case           @relation(fields: [caseId], references: [id])
  type        String
  description String
  status      String @default("ACTIVE")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  versions    DocumentVersion[]
  graphNodes  GraphNode[]

  @@index([caseId])
  @@index([type])
  @@index([status])
}

model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  document         Document @relation(fields: [documentId], references: [id])
  versionNumber    Int
  originalFilename String
  storageKey       String   @unique
  mimeType         String
  sizeBytes        BigInt
  sha256Hash       String
  uploadedById     String
  uploadedBy       User     @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([sha256Hash])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Evidence Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Evidence {
  id              String         @id @default(cuid())
  evidenceRef     String         @unique
  caseId          String
  case            Case           @relation(fields: [caseId], references: [id])
  type            String
  description     String
  source          String
  collectedById   String
  collectedBy     User           @relation(fields: [collectedById], references: [id])
  collectedAt     DateTime
  collectionPlace String
  status          String @default("COLLECTED")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  files           EvidenceFile[]
  custodyEvents   CustodyEvent[]
  certificates    Certificate[]
  graphNodes      GraphNode[]

  @@index([caseId])
  @@index([status])
}

model EvidenceFile {
  id               String   @id @default(cuid())
  evidenceId       String
  evidence         Evidence @relation(fields: [evidenceId], references: [id])
  storageKey       String   @unique
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  sha256Hash       String
  hashAlgorithm    String   @default("SHA-256")
  sourceType       String?
  deviceMake       String?
  deviceModel      String?
  serialNumber     String?
  imei             String?
  uin              String?
  uid              String?
  macAddress       String?
  cloudId          String?
  operationalInfo  String?
  controlInfo      String?
  hashReportRef    String?
  acquiredAt       DateTime @default(now())
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Chain of Custody (append-only) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model CustodyEvent {
  id         String        @id @default(cuid())
  evidenceId String
  evidence   Evidence      @relation(fields: [evidenceId], references: [id])
  fromUserId String?
  fromUser   User?         @relation("CustodyFrom", fields: [fromUserId], references: [id])
  toUserId   String?
  toUser     User?         @relation("CustodyTo", fields: [toUserId], references: [id])
  actorId    String
  actor      User          @relation("CustodyActor", fields: [actorId], references: [id])
  action     String
  place      String
  purpose    String
  notes      String?
  eventHash  String
  occurredAt DateTime
  createdAt  DateTime      @default(now())

  @@index([evidenceId])
  @@index([occurredAt])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Investigation Diary (separate from Technical Audit Trail) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model InvestigationDiaryEntry {
  id                       String           @id @default(cuid())
  caseId                   String
  case                     Case             @relation(fields: [caseId], references: [id])
  pageNumber               Int
  entryDate                DateTime
  informationReceivedAt    DateTime?
  startTime                DateTime?
  endTime                  DateTime?
  placesVisited            String
  proceedings              String
  circumstancesAscertained String?
  witnessRefs              String
  evidenceRefs             String
  documentRefs             String
  officerId                String
  officer                  User             @relation(fields: [officerId], references: [id])
  status                   String @default("ACTIVE")
  supervisorId             String?
  supervisor               User?            @relation("DiaryEntrySupervisor", fields: [supervisorId], references: [id])
  supervisorReviewAt       DateTime?
  supervisorNotes          String?
  createdAt                DateTime         @default(now())

  @@unique([caseId, pageNumber])
  @@index([caseId])
  @@index([entryDate])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Reports Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Report {
  id           String       @id @default(cuid())
  caseId       String
  case         Case         @relation(fields: [caseId], references: [id])
  type         String
  status       String @default("DRAFT")
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  versions     ReportVersion[]
  reviews      Review[]
  notifications Notification[]
  graphNodes   GraphNode[]

  @@index([caseId])
  @@index([status])
}

model ReportVersion {
  id                           String   @id @default(cuid())
  reportId                     String
  report                       Report   @relation(fields: [reportId], references: [id])
  versionNumber                Int
  caseDetails                  String
  persons                      String
  offenceSections              String
  incidentSummary              String
  objectives                   String
  proceedingsSummary           String
  statementsIndex              String
  documentsIndex               String
  evidenceIndex                String
  forensicExamination          String?
  custodyChainSummary          String
  digitalEvidenceCertificates  String
  findings                     String?
  contradictions               String?
  gaps                         String?
  pendingActions               String?
  supervisorObservations       String?
  legalReadiness               String
  finalSummary                 String
  pdfStorageKey                String?
  pdfSha256                    String?
  sha256Hash                   String
  authorId                     String
  author                       User     @relation(fields: [authorId], references: [id])
  createdAt                    DateTime @default(now())

  @@unique([reportId, versionNumber])
  @@index([reportId])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Reviews Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Review {
  id         String         @id @default(cuid())
  reportId   String
  report     Report         @relation(fields: [reportId], references: [id])
  reviewerId String
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  decision   String
  comments   String
  reviewedAt DateTime       @default(now())

  @@index([reportId])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Certificates (BSA s.63) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Certificate {
  id             String            @id @default(cuid())
  caseId         String
  case           Case              @relation(fields: [caseId], references: [id])
  evidenceId     String?
  evidence       Evidence?         @relation(fields: [evidenceId], references: [id])
  certifierId    String
  certifier      User              @relation(fields: [certifierId], references: [id])
  status         String @default("DRAFT")
  sourceType     String
  deviceMake     String?
  deviceModel    String?
  serialNumber   String?
  imei           String?
  hashValue      String
  hashAlgorithm  String            @default("SHA-256")
  hashReportRef  String?
  certifiedDate  DateTime?
  certifiedPlace String?
  additionalInfo String              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([caseId])
  @@index([evidenceId])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Notifications (persistent in DB) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Notification {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  type         String
  caseId       String?
  case         Case?            @relation(fields: [caseId], references: [id])
  reportId     String?
  report       Report?          @relation(fields: [reportId], references: [id])
  resourceType String?
  resourceId   String?
  message      String
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, readAt])
  @@index([caseId])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Technical Audit Log (append-only, restricted) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model AuditLog {
  id           String      @id @default(cuid())
  actorId      String?
  actor        User?       @relation(fields: [actorId], references: [id])
  actorRole    String?
  action       String
  resourceType String?
  resourceId   String?
  caseId       String?
  case         Case?       @relation(fields: [caseId], references: [id])
  result       String
  ipAddress    String?
  userAgent    String?
  metadata     String        @default("{}")
  occurredAt   DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([caseId])
  @@index([occurredAt])
  @@index([result])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Investigation Graph (DB-backed) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model GraphNode {
  id         String    @id @default(cuid())
  caseId     String
  case       Case      @relation(fields: [caseId], references: [id])
  nodeType   String    // CASE | FIR | PERSON | EVENT | LOCATION | DOCUMENT | EVIDENCE | DEVICE | REPORT | CUSTODY | LEGAL
  label      String
  personId   String?
  person     Person?   @relation(fields: [personId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  evidenceId String?
  evidence   Evidence? @relation(fields: [evidenceId], references: [id])
  reportId   String?
  report     Report?   @relation(fields: [reportId], references: [id])
  metadata   String      @default("{}")
  createdAt  DateTime  @default(now())

  outEdges   GraphEdge[] @relation("EdgeFrom")
  inEdges    GraphEdge[] @relation("EdgeTo")

  @@index([caseId])
  @@index([nodeType])
}

model GraphEdge {
  id           String    @id @default(cuid())
  caseId       String
  case         Case      @relation(fields: [caseId], references: [id])
  fromNodeId   String
  fromNode     GraphNode @relation("EdgeFrom", fields: [fromNodeId], references: [id])
  toNodeId     String
  toNode       GraphNode @relation("EdgeTo", fields: [toNodeId], references: [id])
  relationship String    // INVOLVED_IN | WITNESS_OF | LINKED_TO | ACQUIRED_FROM | COLLECTED_AT | SUPPORTS | REFERENCES | TRANSFERRED_TO | OCCURRED_AT | DERIVED_FROM
  metadata     String      @default("{}")
  createdAt    DateTime  @default(now())

  @@index([caseId])
  @@index([fromNodeId])
  @@index([toNodeId])
}